{
  "schema_version": "unpackproof.config.v1",
  "name": "controlled-slow",
  "image": "unpackproof/python-tarfile:0.1",
  "command": ["/unpackproof-guest", "adapter", "slow", "--archive", "{archive}", "--destination", "{destination}", "--delay", "30s"],
  "cases": ["file"],
  "link_policy": "allow",
  "overwrite_policy": "replace",
  "limits": {"timeout": "1s", "memory": "128m", "cpus": "1", "pids": 32, "storage_tmpfs": "8m", "max_captured_output": 8192}
}
