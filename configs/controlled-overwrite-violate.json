{
  "schema_version": "unpackproof.config.v1",
  "name": "controlled-overwrite-violate",
  "image": "unpackproof/python-tarfile:0.1",
  "command": ["/unpackproof-guest", "adapter", "overwrite-violate", "--archive", "{archive}", "--destination", "{destination}"],
  "cases": ["existing"],
  "link_policy": "allow",
  "overwrite_policy": "preserve",
  "limits": {"timeout": "5s", "memory": "128m", "cpus": "1", "pids": 32, "storage_tmpfs": "8m", "max_captured_output": 8192}
}
