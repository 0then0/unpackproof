{
  "schema_version": "unpackproof.config.v1",
  "name": "python-links-reject",
  "image": "unpackproof/python-tarfile:0.1",
  "command": [
    "/adapters/python-tarfile.py",
    "--archive",
    "{archive}",
    "--destination",
    "{destination}",
    "--link-policy",
    "reject",
    "--overwrite-policy",
    "replace"
  ],
  "cases": ["links-denied"],
  "link_policy": "reject",
  "overwrite_policy": "replace",
  "limits": {"timeout": "10s", "memory": "256m", "cpus": "1", "pids": 64, "storage_tmpfs": "16m", "max_captured_output": 65536}
}
